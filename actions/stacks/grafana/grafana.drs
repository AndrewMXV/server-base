Service :node_exporter, image: 'prom/node-exporter:latest', ports: 9100 do
  volume '/:/host:ro,rslave'
  # --collector.filesystem.mount-points-include=^/(var/lib/docker/.+|var/lib/swapspace|var/lib/log)($$|/)
  command '--path.rootfs=/host'
end

# TODO: update
#   "Error response from daemon: client version 1.41 is too old. Minimum supported API version is 1.44, please upgrade your client to a newer version",
Service :docker_state_exporter, image: 'ghcr.io/artyomb/docker_state_exporter:latest', ports: 8080 do
  volume '/var/run/docker.sock:/var/run/docker.sock'
end

Service :otlp_collector, image: 'otel/opentelemetry-collector-contrib:0.102.0', ports: 4318 do
  network :grafana_network
  network :default
  deploy resources: { 'limits.memory': '500 M' } # usual 45 Mb
  config :otlp_yaml, target: '/etc/otelcol-contrib/config.yaml'
end

# Service :speedtest_exporter, image: 'billimek/prometheus-speedtest-exporter:latest' do
#   network :grafana_network
#   network :default
# end

Config :otlp_yaml, file_content: <<~YAML
    receivers:
      otlp:
        protocols:
          http:
          grpc:
    exporters:
  #    debug:
  #      verbosity: detailed
  #      sampling_initial: 5
  #      sampling_thereafter: 200
      otlphttp/tempo:
        endpoint: http://tempo:4318
        tls:
          insecure: true
      prometheusremotewrite:
  #      endpoint: http://prometheus:9090/api/v1/write
        endpoint: http://victoriametrics:8428/api/v1/write
        resource_to_telemetry_conversion:
          enabled: true
      loki:
        endpoint: http://loki:3100/loki/api/v1/push
        tls:
          insecure: true
    service:
      pipelines:
        traces:
          receivers: [ otlp ]
          exporters: [ otlphttp/tempo ]
        metrics:
          receivers: [ otlp]
          exporters: [ prometheusremotewrite ]
        logs:
          receivers: [ otlp]
          exporters: [ loki ]
YAML

Config :tempo_yaml, file_content: <<~YAML
  # Defaults: https://github.com/grafana/tempo/blob/2870e82df7045b41c166da4a624ae8d68c0e6394/docs/sources/tempo/configuration/manifest.md?plain=1#L499
  stream_over_http_enabled: true
  usage_report:
    reporting_enabled: false
  server:
    http_listen_port: 3200
    log_level: info

  memberlist:
    bind_addr:
      - 0.0.0.0
    join_members:
      - tempo:7946

  query_frontend:
    search:
      duration_slo: 5s
      throughput_bytes_slo: 1.073741824e+09
    trace_by_id:
      duration_slo: 5s

  querier:
    frontend_worker:
      frontend_address: 127.0.0.1:9095

  distributor:
    receivers:                           # this configuration will listen on all ports and protocols that tempo is capable of.
      otlp:
        protocols:
          http:
            endpoint: "0.0.0.0:4318"

  metrics_generator:
    # https://grafana.com/docs/tempo/latest/configuration/#metrics-generator
    processor:
      # Span metrics create metrics based on span type, duration, name and service.
      span_metrics:
        # Configure extra dimensions to add as metric labels.
        dimensions:
          - deployment.environment
      service_graphs:
        # Enables additional labels for services and virtual nodes.
        enable_virtual_node_label: true
        peer_attributes:
          - peer.service
          - service.name # +
          - host.name # +
          - db.name
          - db.system
        dimensions:
          - deployment.environment
      local_blocks:
        flush_to_storage: true

    registry:
      external_labels:
        source: tempo
        cluster: docker-compose
    storage:
      path: /var/tempo/generator/wal
      remote_write:
        # - url: http://prometheus:9090/api/v1/write
        - url: http://victoriametrics:8428/api/v1/write
          send_exemplars: true
    traces_storage:
      path: /var/tempo/generator/traces

  compactor:
    compaction:
      block_retention: 168h
      compacted_block_retention: 1h

  storage:
    trace:
      backend: local                     # backend configuration to use
      wal:
        path: /var/tempo/wal             # where to store the the wal locally
      local:
        path: /var/tempo/blocks

  overrides:
    defaults:
      ingestion:
        max_traces_per_user: 50000
      metrics_generator:
        # https://grafana.com/docs/tempo/latest/configuration/#overrides
        processors: [service-graphs, span-metrics, local-blocks] # enables metrics generator

YAML

Config :grafana_datasources_yaml, file_content: <<~YAML
  apiVersion: 1

  datasources:
  - name: Loki # Display name
    type: loki # Datasource type
    uid: loki
    access: proxy #
    orgId: 1 # Grafana organization ID
    url: http://loki:3100 # Internal Loki service URL
    basicAuth: false # Loki auth is disabled in this demo stack
    isDefault: false #
    version: 1 #
    editable: false # Keep datasource managed by provisioning
  
  # This "Prometheus" datasource actually points to VictoriaMetrics
  # Keep uid: prometheus to avoid changing dashboards
  - name: Prometheus
    type: prometheus
    uid: prometheus
    access: proxy
    orgId: 1
    url: http://victoriametrics:8428
    # url: http://prometheus:9090
    basicAuth: false
    isDefault: false
    version: 1
    editable: false
    jsonData:
      httpMethod: GET
  - name: Tempo
    type: tempo
    access: proxy
    orgId: 1
    url: http://tempo:3200
    basicAuth: false
    isDefault: true
    version: 1
    editable: false
    apiVersion: 1
    uid: tempo
    jsonData:
      # httpMethod: GET
      serviceMap:
        datasourceUid: prometheus
YAML

Config :grafana_dashboards_yaml, file_content: <<~YAML
  apiVersion: 1

  providers:
    - name: "Dashboard provider"
      orgId: 1
      type: file
      disableDeletion: false
      updateIntervalSeconds: 10
      allowUiUpdates: false
      options:
        path: /var/lib/grafana/dashboards
        foldersFromFilesStructure: true
YAML

Network :grafana_network, external: true , name: 'grafana-network'
