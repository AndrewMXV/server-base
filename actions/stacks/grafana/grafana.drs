Description <<~DCS
  Tempo
DCS
Labels 'stack.product': 'tempo'

Options name: 'grafana' , traefik: true, traefik_tls: !!ENV['TLS_DOMAIN'] , tls_domain: ENV['TLS_DOMAIN']

basic_auth = ENV.fetch('GRAFANA_BASIC_AUTH', ENV.fetch('TRAEFIK_BASIC_AUTH', 'admin:admin:demo'))

Ingress grafana: [{ host: 'tempo.*', oauth_provider: 'oauth2_oauth2_slim:7000/auth' },
                  { path: '/map/grafana', oauth_provider: 'oauth2_oauth2_slim:7000/auth' }
                 ],
        otlp_collector: [{ host: 'otel.*' },
                         { host: '*', path: '/otel', path_sub: ['^/otel(.*)', '$1'] },
                         { host: '*', path: '/map/otel/v1', path_sub: ['^/map/otel(.*)', '$1'] }, # UP priority  - "traefik.http.routers.Router-2.priority=2"
                         { host: 'otel.*', path: '/grpc', path_sub: ['^/grpc(.*)', '$1'], port: 4317 },
                         { host: '*', path: '/otel/grpc', path_sub: ['^/otel\/grpc(.*)', '$1'], port: 4317 }
        ], # use host: '*' to rise traefik rule priority up
        cadvisor: { host: 'cadvisor.*', oauth_provider: 'oauth2_oauth2_slim:7000/auth' },
        victoriametrics: { host: 'victoriametrics.*', oauth_provider: 'oauth2_oauth2_slim:7000/auth' },
        swarm_timeliner: { host: 'tt.*', oauth_provider: 'oauth2_oauth2_slim:7000/auth' }


# get the name of the default network interface:
# $ ifconfig -s -a
# $ iptables -I DOCKER-USER -i eth0 -p tcp --destination-port 3100 -j REJECT
PublishPorts loki: [3100]

Deploy [:loki, :otlp_collector_host, :cadvisor],
       { 'placement.constraints': ['node.role == manager'] }

Deploy [:node_exporter, :promtail, :fluent_bit2], { mode: 'global' }

Logging [:prometheus, :grafana, :tempo, :cadvisor], driver: 'loki', options: {
  'loki-url': 'http://localhost:3100/loki/api/v1/push',
  'loki-batch-size': 100, 'loki-retries': 2, 'loki-max-backoff': '1000ms', 'loki-timeout': '1s', 'max-size': "250m",'max-file': "3" }

Service :tempo, image: "grafana/tempo:#{ENV['TEMPO_TAG'] || '2.8.3'}", ports: 4318 do
  command '-config.file=/etc/tempo.yaml'
  network :default
  network :grafana_network
  ingress  host: 'tempo.grafana-network.*', basic_auth: basic_auth, port: 3200
  deploy resources: { 'limits.memory': '3 G' }

  volume target: '/var/tempo', name: 'tempo_data'
  config :tempo_yaml, target: '/etc/tempo.yaml'
end

if ENV['GPU_NODE']
# docker run -d --gpus all --cap-add SYS_ADMIN --rm -p 9400:9400
# curl localhost:9400/metrics
Service :dcgm_exporter, image: 'nvidia/dcgm-exporter:4.5.2-4.8.1-distroless', ports: 9400 do
  cap_add %w[SYS_ADMIN]
  network :grafana_network
  network :default
  env NVIDIA_VISIBLE_DEVICES: "all"
  env NVIDIA_DRIVER_CAPABILITIES: "compute,utility"
  env DCGM_EXPORTER_COLLECTORS: '/etc/dcgm-exporter/dcp-metrics-included.csv'
  env DCGM_EXPORTER_DEVICES_STR: 'f'
end
end

