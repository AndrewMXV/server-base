# https://grafana.com/docs/grafana/latest/breaking-changes/breaking-changes-v11-0/
Service :grafana, image: 'grafana/grafana:latest', ports: 3000 do
  env GF_ADMIN_USER: 'admin'
  env GF_ADMIN_PASSWORD: ENV.fetch('GF_ADMIN_PASSWORD', 'admin')
  env GF_AUTH_ANONYMOUS_ENABLED: false
  env GF_SERVER_SERVE_FROM_SUB_PATH: true
  env GF_SERVER_ROOT_URL: '/map/grafana'
  # env GF_SERVER_ROOT_URL: "#{ENV['SCHEME']}://#{ENV['MAIN_DOMAIN']}/map/grafana"
  # env GF_SERVER_ROOT_URL: "https://tempo.#{ENV['MAIN_DOMAIN']}"
  if ENV['DOCKER_PROXY']
    env HTTP_PROXY: ENV['DOCKER_PROXY']
    env HTTPS_PROXY: ENV['DOCKER_PROXY']
    env NO_PROXY: "localhost,127.0.0.1,prometheus,victoriametrics,tempo,loki,#{ENV['DOCKER_NOPROXY']}"
  end

  # env GF_AUTH_GENERIC_OAUTH_ENABLED: true
  # env GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE: 'email'
  # env GF_AUTH_GENERIC_OAUTH_USERNAME_ATTRIBUTE: 'admin'
  # env GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH: 'email'
  # env GF_AUTH_GENERIC_OAUTH_ALLOW_UPDATE: true
  # env GF_AUTH_GENERIC_OAUTH_AUTO_ASSIGN_ORG_ROLE: 'Admin'
  # env GF_AUTH_GENERIC_OAUTH_SKIP_ORG_ROLE_SYNC: true
  # env GF_AUTH_GENERIC_OAUTH_IGNORE_PASSWORD_UPDATE: true
  # env GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP: true
  # # env GF_AUTH_GENERIC_OAUTH_SKIP_ORG_ROLE_SYNC_FOR_EXISTING_USERS: false
  # env GF_AUTH_GENERIC_OAUTH_AUTH_ID_ATTRIBUTE: 'admin' # sub
  # env GF_AUTH_OAUTH_ALLOW_INSECURE_EMAIL_LOOKUP: true
  # env GF_AUTH_GENERIC_OAUTH_AUTO_ASSIGN_ORG_ROLE: 'Admin'
  # env GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH: "'Admin'"
  # # env GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH: "contains(roles[*], 'admin') && 'Admin' || contains(roles[*], 'editor') && 'Editor' || 'Viewer'"
  # # env GF_USERS_ALLOW_DELETE_ADMIN: true
  # env GF_AUTH_GENERIC_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN: true
  # env GF_AUTH_GENERIC_OAUTH_IDENTIFY_ATTRIBUTE_PATH: 'admin'
  # env GF_AUTH_GENERIC_OAUTH_ID_TOKEN_ATTRIBUTE_NAME: 'admin' # 'sub'
  # env GF_AUTH_GENERIC_OAUTH_AUTH_URL: "https://#{ENV['MAIN_DOMAIN']}/authorize"
  # env GF_AUTH_GENERIC_OAUTH_TOKEN_URL: "http://oauth2_oauth2_slim:7000/oauth/token"
  # env GF_AUTH_GENERIC_OAUTH_API_URL: "http://oauth2_oauth2_slim:7000/oauth/user"

  # [plugins]
  # allow_loading_unsigned_plugins = docker-events-analyzer
  env GF_PLUGINS_ALLOW_LOADING_UNSIGNED_PLUGINS: 'docker-events-analyzer'
  config target: '/var/lib/grafana/plugins/docker_events_analyzer/plugin.json', file: './gf_plugins/docker_events_analyzer/plugin.json'
  config target: '/var/lib/grafana/plugins/docker_events_analyzer/module.js', file: './gf_plugins/docker_events_analyzer/module.js'

  network :grafana_network
  network :default
  config :grafana_datasources_yaml, target: '/etc/grafana/provisioning/datasources/datasources.yaml'
  config :grafana_dashboards_yaml, target: '/etc/grafana/provisioning/dashboards/main.yaml'
  config target: '/var/lib/grafana/dashboards/traefik.json', file: './dashboards/traefik.json'
  config target: '/var/lib/grafana/dashboards/cadvisor.json', file: './dashboards/cadvisor.json'
  config target: '/var/lib/grafana/dashboards/cadvisor2.json', file: './dashboards/cadvisor2.json'
  # config target: '/var/lib/grafana/dashboards/speedtest.json', file: './dashboards/speedtest.json'
  config target: '/var/lib/grafana/dashboards/node_exporter.json', file: './dashboards/node_exporter.json' # https://grafana.com/grafana/dashboards/1860-node-exporter-full/
  config target: '/var/lib/grafana/dashboards/swarm_stack.json', file: './dashboards/swarm_stack.json' # https://grafana.com/grafana/dashboards/7007-swarm-stack-monitoring/
  config target: '/var/lib/grafana/dashboards/loki.json', file: './dashboards/loki.json' # https://grafana.com/grafana/dashboards/17781-loki-metrics-dashboard/
  config target: '/var/lib/grafana/dashboards/loki_ingest_metrics.json', file: './dashboards/loki_ingest_metrics.json'
  config target: '/var/lib/grafana/dashboards/tempo_span_metrics.json', file: './dashboards/tempo_span_metrics.json'
  # config target: '/var/lib/grafana/dashboards/prometheus_20_stats.json', file: './dashboards/prometheus_20_stats.json'
  config target: '/var/lib/grafana/dashboards/nats_jetstreams.json', file: './dashboards/nats_jetstreams.json'
  config target: '/var/lib/grafana/dashboards/nats_servers.json', file: './dashboards/nats_servers.json'
  config target: '/var/lib/grafana/dashboards/vm_single_node.json', file: './dashboards/vm_single_node.json'
  config target: '/var/lib/grafana/dashboards/cadvisor_19792_rev6.json', file: './dashboards/cadvisor_19792_rev6.json'
  if ENV['GPU_NODE']
    config target: '/var/lib/grafana/dashboards/gpus.json', file: './dashboards/gpus.json'
    config target: '/var/lib/grafana/dashboards/gpus2.json', file: './dashboards/gpus2.json'
    config target: '/var/lib/grafana/dashboards/gpus3.json', file: './dashboards/gpus3.json'
    config target: '/var/lib/grafana/dashboards/nvidia_dcgm_v1.json', file: './dashboards/nvidia_dcgm_v1.json'
  end

  config target: '/etc/grafana/provisioning/alerting/alert_rules.yaml', file: './alerting/alert_rules.yaml'
  # config target: '/etc/grafana/provisioning/alerting/policies.yaml', file: './alerting/policies.yaml'

  if ENV['TELEGRAM_BOT_TOKEN'] && ENV['TELEGRAM_CHAT_ID']
    config target: '/etc/grafana/provisioning/alerting/contact_points.yaml', file_content: <<~YAML
      apiVersion: 1
      contactPoints:
        - orgId: 1
          name: Telegram
          receivers:
            - uid: telegram-alerts
              type: telegram
              settings:
                bottoken: #{ENV['TELEGRAM_BOT_TOKEN'].to_s.dump}
                chatid: #{ENV['TELEGRAM_CHAT_ID'].to_s.dump}
                disable_notification: false
                disable_web_page_preview: false
                message: |
                  <strong>Grafana (#{ENV['MAIN_DOMAIN']}):</strong>
                  {{- range .Alerts.Firing }}
                  - [F] {{ index .Labels "alertname" }}: {{ .Annotations.summary }} {{ .Annotations.description }}
                  {{- end }}
                  {{- range .Alerts.Resolved }}
                  - [R] {{ index .Labels "alertname" }}: {{ .Annotations.summary }} {{ .Annotations.description }}
                  {{ end }}
                parse_mode: HTML
                protect_content: false
              disableResolveMessage: false
    YAML
  end
end

# https://medium.com/@ahmadbilalch891/how-to-set-up-grafana-loki-and-prometheus-locally-with-docker-compose-part-1-of-3-62fb25e51d92
Service :loki, image: 'grafana/loki:latest', ports: 3100 do
  command <<~CC
    -config.file=/etc/loki/local-config.yaml
    -distributor.ring.instance-addr=127.0.0.1
    -frontend.instance-addr=127.0.0.1
    -index-gateway.ring.instance-addr=127.0.0.1
    -ingester.lifecycler.addr=127.0.0.1
    -query-scheduler.ring.instance-addr=127.0.0.1
    -ruler.ring.instance-addr=127.0.0.1
  CC
  network :default
  network :grafana_network
  ingress  host: 'loki.grafana-network.*', basic_auth: basic_auth, port: 3100
  deploy resources: { 'limits.memory': '1 G' }

  volume target: '/data', name: 'loki_data'
  user '0:0'
  config target: '/etc/loki/local-config.yaml', file_content: <<~YAML
        auth_enabled: false
        server:
    #      http_listen_address: 0.0.0.0
    #      grpc_listen_address: 0.0.0.0
    #      http_listen_port: 3100
    #      grpc_listen_port: 9095
          log_level: debug
        common:
    #      instance_interface_names: 
    #        - "lo"
          ring:
            instance_addr: 127.0.0.1
            kvstore:
              store: inmemory
          replication_factor: 1
          path_prefix: /data/loki
        compactor:
          working_directory: /data/loki/compactor
          compaction_interval: 5m
          retention_enabled: true
          delete_request_store: filesystem
        schema_config:
          configs:
          - from: 2020-05-15
            store: tsdb
            object_store: filesystem
            schema: v13
            index:
              prefix: index_
              period: 24h
        ingester:
          lifecycler:
            address: 0.0.0.0
            ring:
              kvstore:
                store: inmemory
              replication_factor: 1
            final_sleep: 0s
            min_ready_duration: 15s
          chunk_idle_period: 5m
          chunk_target_size: 1048576
          max_chunk_age: 30m
        limits_config:
          ingestion_rate_mb: 16
          ingestion_burst_size_mb: 32
          max_global_streams_per_user: 5000
          retention_period: 240h # 10 days       
        table_manager:
          retention_deletes_enabled: true
          retention_period: 240h # 10 days
        analytics:
          reporting_enabled: false
        storage_config:
          filesystem:
            directory: /data/loki/chunks
  YAML
end

# https://docs.fluentbit.io/manual/pipeline/outputs/loki
Service :fluent_bit2, image: 'fluent/fluent-bit:latest' do
  volume '/var/run/docker.sock:/var/run/docker.sock'  # Required for Docker API access
  config target: '/fluent-bit/etc/parsers2.conf', file_content: <<~CONF
    [PARSER]
        Name         docker_events_json
        Format       json
        Time_Key     time
  CONF
  config target: '/fluent-bit/etc/fluent-bit.conf', file_content: <<~CONF
    [SERVICE]
      flush        10
      daemon       Off
      parsers_file parsers.conf
      parsers_file parsers2.conf
      plugins_file plugins.conf
      log_level    info

    [INPUT]
        Name   docker_events
        Parser docker_events_json

    [OUTPUT]
        Name             loki
        Match            *
        Host             loki
        Port             3100
        Labels           job=docker_events
        Line_Format      json
  CONF
end

Service :promtail, image: 'grafana/promtail:latest' do
  volume '/var/run/docker.sock:/var/run/docker.sock'  # Required for Docker API access
  volume '/var/lib/docker/containers:/var/lib/docker/containers:ro'  # Container logs
  volume '/var/log:/var/log'  # Access to system logs (e.g., Docker daemon logs)
  volume target: '/etc/promtail'
  command "-config.file=/etc/promtail/promtail-config.yml" #  --dry-run --inspect

  network :grafana_network
  network :default
  # deploy resources: { 'limits.memory': '500 M' }

  config target: '/etc/promtail/promtail-config.yml', file_content: <<~YAML
    server: { http_listen_port: 9080, grpc_listen_port: 0 }
    positions: { filename: /var/log/positions.yaml }
    clients: [ url: http://loki:3100/loki/api/v1/push ]

    scrape_configs:
      - job_name: journal
        journal:
          path: /var/log/journal
          max_age: 1h
          labels:
            job: systemd-journal
        relabel_configs:
          - source_labels: [ __journal__hostname ]
            target_label: hostname
          - source_labels: [ __journal__systemd_unit ] # example label values: kubelet.service, containerd.service
            target_label: unit
          - source_labels: [ __journal_priority_keyword ] # example label values: debug, notice, info, warning, error
            target_label: level
  YAML
end

Service :cadvisor, image: 'gcr.io/cadvisor/cadvisor:v0.55.1', ports: 8080 do
  command %w[
    -containerd=/run/containerd/containerd.sock
    -store_container_labels=false
    -whitelisted_container_labels=com.docker.stack.namespace,com.docker.swarm.service.name,com.docker.swarm.task.id
    -housekeeping_interval=15s
    -max_housekeeping_interval=2m
    -event_storage_age_limit=default=1h
    -event_storage_event_limit=default=1000
  ]
  # -docker_only
  # -disable_root_cgroup_stats
  # cap_add %w[SYS_ADMIN] # manager.go:338 Could not configure a source for OOM detection, disabling OOM events: open /dev/kmsg: operation not permitted
  cap_add %w[ALL]
  volume '/run/containerd/containerd.sock:/run/containerd/containerd.sock:ro'
  volume '/var/lib/containerd:/var/lib/containerd:ro'
  volume '/:/rootfs:ro'
  volume '/var/run:/var/run:rw'
  volume '/proc:/host-proc:ro'
  volume '/sys:/sys:ro'
  volume '/var/lib/docker/:/var/lib/docker:ro'
  volume '/dev/disk/:/dev/disk:ro'
  volume '/dev/kmsg:/dev/kmsg'
  # volume '/dev/zfs:/dev/zfs:ro'
  network :grafana_network
  network :default
end

