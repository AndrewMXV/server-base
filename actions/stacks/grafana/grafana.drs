# https://grafana.com/orgs/victoriametrics/dashboards
Service :victoriametrics, image: 'victoriametrics/victoria-metrics:latest', ports: 8428 do
  # /metrics/api/v1/query
  network :default
  network :grafana_network
  ingress  host: 'metrics.grafana-network.*', basic_auth: basic_auth
  deploy resources: { 'limits.memory': '1 G' }

  command %w[
    -retentionPeriod=3d
    -storageDataPath=/storage
    -httpListenAddr=:8428
    -maxLabelsPerTimeseries=110
  ]
  volume target: '/storage', name: 'victoriametrics_data'
end

Service :vmagent, image: 'victoriametrics/vmagent:latest' do
  command %w[
   -promscrape.config=/etc/vmagent.yaml
   -remoteWrite.url=http://victoriametrics:8428/api/v1/write
   -promscrape.config.strictParse=false
   -promscrape.maxScrapeSize=33554432
   -promscrape.dockerswarmSDCheckInterval=10s
  ]
  network :grafana_network
  network :default
  deploy resources: { 'limits.memory': '512 M' }
  volume '/var/run/docker.sock:/var/run/docker.sock:ro'
  vmagent_yaml = <<~'YAML'
    global:
      scrape_interval:     15s
    scrape_configs: [
      { job_name: "tempo", static_configs: [ { targets: ["tempo:3200"] } ] },
      { job_name: "cadvisor",
        static_configs: [ { targets: ["cadvisor:8080"] } ],
        metric_relabel_configs: [
          { action: "labeldrop", regex: "container_label_com_gitlab_ci_.*" },
          { action: "labeldrop", regex: "container_label_org_label_schema_.*" },
          { action: "labeldrop", regex: "container_label_org_opencontainers_.*" },
          { action: "labeldrop", regex: "container_label_com_docker_compose_.*" },
          { action: "labeldrop", regex: "container_label_com_docker_swarm_(node_id|service_id|task_name)" },
          { action: "labeldrop", regex: "container_label_com_docker_stack_image" },
          { action: "labeldrop", regex: "container_label_docker_service_name" },
          { action: "labeldrop", regex: "container_label_maintainer" }
        ]
      },
      { job_name: "docker_state_exporter", static_configs: [ { targets: ["docker_state_exporter:8080"] } ] },
      { job_name: "node-exporter", static_configs: [ { targets: ["node_exporter:9100"] } ] },
      { job_name: "loki", metrics_path: /metrics, static_configs: [ { targets: ["loki:3100"] } ] },
      { job_name: "traefik", metrics_path: /metrics, static_configs: [ { targets: [ traefik:9090 ] } ] },
      { job_name: "prometheus_nats_exporter", metrics_path: /metrics, static_configs: [ { targets: [ prometheus_nats_exporter:7777 ] } ] },
      { job_name: "victoriametrics", static_configs: [ { targets: [victoriametrics:8428] } ] },
      { job_name: "vmagent", static_configs: [ { targets: [localhost:8429] } ] },
      { job_name: "dockerswarm_dynamic", scrape_interval: 15s,
        dockerswarm_sd_configs: [ { host: 'unix:///var/run/docker.sock', role: 'tasks' } ],
        relabel_configs: [
          { source_labels: [__meta_dockerswarm_task_desired_state], regex: 'running', action: keep },
          { source_labels: [__meta_dockerswarm_service_label_metrics_port], regex: '[0-9]+', action: keep },
          { source_labels: [__meta_dockerswarm_network_name], regex: 'grafana-network', action: keep },
          { source_labels: [__meta_dockerswarm_service_label_metrics_path], regex: '(.+)', target_label: __metrics_path__, replacement: '$1', action: replace },
          { source_labels: [__meta_dockerswarm_service_label_metrics_scheme], regex: '(https?)', target_label: __scheme__, replacement: '$1', action: replace },
          { source_labels: [__address__, __meta_dockerswarm_service_label_metrics_port], regex: '([^:]+)(?::[0-9]+)?;([0-9]+)', target_label: __address__, replacement: '$1:$2', action: replace },
          { source_labels: [__meta_dockerswarm_service_name], target_label: service_name, action: replace },
          { source_labels: [__meta_dockerswarm_service_label_com_docker_stack_namespace], target_label: stack, action: replace },
          { source_labels: [__meta_dockerswarm_service_name, __meta_dockerswarm_task_slot, __meta_dockerswarm_task_id], regex: '(.+);(.+);(.+)', target_label: instance, replacement: '$1.$2.$3', action: replace },
          { source_labels: [__meta_dockerswarm_node_hostname], target_label: swarm_node, action: replace },
          { source_labels: [__meta_dockerswarm_service_label_stack_product], regex: '(.+)', target_label: stack_product, replacement: '$1', action: replace }
        ]
      },
    ]
  YAML
  if ENV['GPU_NODE']
    require 'yaml'
    ext_yaml = <<~'YAML'
      scrape_configs: [
        { job_name: dcgm_exporter, metrics_path: /metrics, static_configs: [ { targets: [dcgm_exporter:9400] } ] }
      ]
    YAML
    base = YAML.safe_load(vmagent_yaml, aliases: true)
    ext = YAML.safe_load(ext_yaml, aliases: true)
    base['scrape_configs'] += ext['scrape_configs']
    vmagent_yaml = YAML.dump(base).sub(/\A---\s*\n/, '')
   end

  config target: '/etc/vmagent.yaml', file_content: vmagent_yaml
end

